{
	"name": "cash-book",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"preci": "npm run refactor",
		"ci": "export CI=true && npm run compile && npm run coverage && npm run build",
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage",
		"compile": "tsc",
		"lint": "eslint src",
		"refactor": "npm run update-browser-list && npm run lint --fix",
		"preanalyze": "npm run build",
		"analyze": "source-map-explorer 'build/static/js/*.js'",
		"update-browser-list": "echo y | npx browserslist@latest --update-db"
	},
	"dependencies": {
		"@headlessui/react": "^1.4.2",
		"@heroicons/react": "^1.0.5",
		"crypto-js": "^4.1.1",
		"history": "^5.2.0",
		"react": "^18.3.1",
		"react-dnd": "^14.0.5",
		"react-dnd-html5-backend": "^14.1.0",
		"react-dnd-touch-backend": "^14.1.1",
		"react-dom": "^18.3.1",
		"react-redux": "^7.2.6",
		"react-router-dom": "^6.2.1",
		"redux": "^4.1.2",
		"redux-saga": "^1.1.3",
		"source-map-explorer": "^2.5.2",
		"web-vitals": "^2.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^14.3.1",
		"@testing-library/user-event": "^13.2.1",
		"@types/crypto-js": "^4.1.0",
		"@types/jest": "^27.0.1",
		"@types/node": "^22.19.3",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/coverage-v8": "^4.0.16",
		"autoprefixer": "^10.4.1",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.0.0",
		"jsdom": "^27.4.0",
		"postcss": "^8.4.5",
		"redux-devtools-extension": "^2.13.9",
		"redux-saga-test-plan": "^4.0.4",
		"tailwindcss": "^3.0.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.16"
	},
	"jest": {
		"collectCoverageFrom": [
			"!<rootDir>",
			"src/backupMigrations/**/*.{ts,tsx}",
			"src/backupValidation/**/*.{ts,tsx}",
			"src/sideEffects/**/*.{ts,tsx}",
			"src/features/**/reducer/**/*.{ts,tsx}",
			"src/features/**/*reducer*.ts",
			"src/features/**/validation.ts",
			"src/models/currencyInt.ts",
			"src/misc/makeUniqueID.ts",
			"src/misc/toBackup.ts",
			"!src/**/index.{ts,tsx}",
			"!src/backupMigrations/(v1|v2).ts"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
